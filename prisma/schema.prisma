// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// Clerk is the source of truth for users and organizations.
// App data just needs to remember which Clerk organization it belongs to.
model Task {
  id        String     @id @default(cuid())
  title     String
  status    TaskStatus @default(TODO)
  orgId     String
  createdBy String
  createdAt DateTime   @default(now())

  @@index([orgId])
}
